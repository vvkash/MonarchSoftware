<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MonarchSoftware" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/monarch_green</item>
        <item name="colorPrimaryVariant">@color/monarch_green_dark</item>
        <item name="colorSecondary">@color/brand_gold</item>
        <item name="colorAccent">@color/brand_gold</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/header_surface</item>
        <item name="android:navigationBarColor">@color/header_surface</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- Theme with action bar for Keystroke PIN screen -->
    <style name="Theme.MonarchSoftware.ActionBar" parent="Theme.MonarchSoftware"/>

    <style name="Theme.MonarchSoftware.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_monarch_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.MonarchSoftware</item>
    </style>

    <!-- Legacy alias used by Phase2Study layouts -->
    <style name="Theme.Phase2Study" parent="Theme.MonarchSoftware"/>

    <!-- AppBar overlay for Keystroke PIN screen toolbar -->
    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar"/>
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.MaterialComponents"/>

    <!-- Biometrics form styles -->
    <style name="parent">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="modifiedEditText" parent="parent">
        <item name="android:textSize">@dimen/newsMoreTextSize</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <style name="Widget.Monarch.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/button_primary_tint</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Monarch.SecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/border</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Widget.Monarch.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="loginButton" parent="Widget.Monarch.PrimaryButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="SaveButton" parent="Widget.Monarch.PrimaryButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="SocialActionButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">9dp</item>
    </style>

    <style name="SocialNavButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">16dp</item>
    </style>
</resources>
