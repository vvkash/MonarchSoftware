<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F4F0">

    <!-- Header bar -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#12111A"
        android:padding="12dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SWIPE STUDY"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/tv_stroke_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Strokes recorded: 0"
                android:textSize="11sp"
                android:textColor="#BDB08A"/>
        </LinearLayout>

        <Button
            android:id="@+id/btn_swipe_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Done"
            android:backgroundTint="#D4A843"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

    <!-- Instruction -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text="Scroll through the articles naturally. Your swipe gestures are being recorded."
        android:textSize="12sp"
        android:textColor="#6B7280"
        android:background="#EEEBE4"/>

    <!-- Scrollable article feed -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_feed"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"/>

</LinearLayout>
