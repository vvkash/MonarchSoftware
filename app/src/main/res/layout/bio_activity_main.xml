<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/register_bk_color"
    android:focusableInTouchMode="true"
    tools:context="com.monarch.software.biometrics.BiometricsMainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Monarch header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#12111A"
                android:orientation="vertical"
                android:padding="24dp"
                android:paddingTop="48dp"
                android:paddingBottom="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MONARCH"
                    android:textSize="10sp"
                    android:textColor="#BDB08A"
                    android:letterSpacing="0.2"
                    android:paddingBottom="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sensor Collection"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap Start to begin recording biometric data."
                    android:textSize="13sp"
                    android:textColor="#BDB08A"
                    android:paddingTop="6dp"/>
            </LinearLayout>

            <!-- Live sensor data card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="20dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIVE SENSOR DATA"
                        android:textSize="10sp"
                        android:textColor="#BDB08A"
                        android:letterSpacing="0.15"
                        android:paddingBottom="12dp"/>

                    <CheckedTextView
                        android:id="@+id/AT9"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="14sp"
                        android:textColor="#12111A"
                        android:textStyle="bold"
                        android:fontFamily="monospace"/>

                    <Space android:layout_width="match_parent" android:layout_height="24dp" />

                    <!-- Start / Stop row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/Button_Write"
                            style="@style/SaveButton"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="Start"
                            android:textAlignment="center"
                            android:textSize="15sp"/>

                        <Button
                            android:id="@+id/Button_Stop"
                            style="@style/SaveButton"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:textAlignment="center"
                            android:text="Stop"
                            android:textSize="15sp"/>
                    </LinearLayout>

                    <Space android:layout_width="match_parent" android:layout_height="12dp" />

                    <Button
                        android:id="@+id/Button_Share"
                        style="@style/SaveButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Share / Export CSV"
                        android:textAlignment="center"
                        android:textSize="15sp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
