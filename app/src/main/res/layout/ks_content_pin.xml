<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
    android:background="#F6F4F0">

    <!-- Monarch sub-header (sits below AppBar toolbar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#12111A"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KEYSTROKE AUTH"
                android:textSize="10sp"
                android:textColor="#BDB08A"
                android:letterSpacing="0.15"/>

            <TextView
                android:id="@+id/attempt_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#Entry no. 1"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/right_wrong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="#BDB08A"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/switch_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RE-TRAIN"
                android:textSize="9sp"
                android:textColor="#BDB08A"
                android:letterSpacing="0.1"/>

            <Switch
                android:id="@+id/switch1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>

    <!-- PIN display row -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView android:layout_width="0dp" android:layout_height="48dp"
            android:id="@+id/password_1" android:gravity="center" android:enabled="false"
            android:layout_weight="1" android:maxLength="1" android:textSize="28sp"
            android:textColor="#12111A" android:textStyle="bold"/>

        <TextView android:layout_width="0dp" android:layout_height="48dp"
            android:id="@+id/password_2" android:gravity="center" android:enabled="false"
            android:layout_weight="1" android:maxLength="1" android:textSize="28sp"
            android:textColor="#12111A" android:textStyle="bold"/>

        <TextView android:layout_width="0dp" android:layout_height="48dp"
            android:id="@+id/password_3" android:gravity="center" android:enabled="false"
            android:layout_weight="1" android:maxLength="1" android:textSize="28sp"
            android:textColor="#12111A" android:textStyle="bold"/>

        <TextView android:layout_width="0dp" android:layout_height="48dp"
            android:id="@+id/password_4" android:gravity="center" android:enabled="false"
            android:layout_weight="1" android:maxLength="1" android:textSize="28sp"
            android:textColor="#12111A" android:textStyle="bold"/>

        <TextView android:layout_width="0dp" android:layout_height="48dp"
            android:id="@+id/password_5" android:gravity="center" android:enabled="false"
            android:layout_weight="1" android:maxLength="1" android:textSize="28sp"
            android:textColor="#12111A" android:textStyle="bold"/>

        <TextView android:layout_width="0dp" android:layout_height="48dp"
            android:id="@+id/password_6" android:gravity="center" android:enabled="false"
            android:layout_weight="1" android:maxLength="1" android:textSize="28sp"
            android:textColor="#12111A" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
        android:layout_marginTop="8dp" android:layout_marginBottom="4dp"
        android:background="#E5E0D8"/>

    <!-- Numpad -->
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
        android:layout_height="match_parent" android:layout_weight="1">

        <TextView android:layout_width="0dp" android:layout_height="match_parent"
            android:text="1" android:id="@+id/t1" android:gravity="center"
            android:layout_weight="1" android:textSize="26sp" android:textColor="#12111A" android:textStyle="bold"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent"
            android:text="2" android:id="@+id/t2" android:gravity="center"
            android:layout_weight="1" android:textSize="26sp" android:textColor="#12111A" android:textStyle="bold"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent"
            android:text="3" android:id="@+id/t3" android:gravity="center"
            android:layout_weight="1" android:textSize="26sp" android:textColor="#12111A" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
        android:layout_height="match_parent" android:layout_weight="1">

        <TextView android:layout_width="0dp" android:layout_height="match_parent"
            android:text="4" android:id="@+id/t4" android:gravity="center"
            android:layout_weight="1" android:textSize="26sp" android:textColor="#12111A" android:textStyle="bold"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent"
            android:text="5" android:id="@+id/t5" android:gravity="center"
            android:layout_weight="1" android:textSize="26sp" android:textColor="#12111A" android:textStyle="bold"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent"
            android:text="6" android:id="@+id/t6" android:gravity="center"
            android:layout_weight="1" android:textSize="26sp" android:textColor="#12111A" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
        android:layout_height="match_parent" android:layout_weight="1">

        <TextView android:layout_width="0dp" android:layout_height="match_parent"
            android:text="7" android:id="@+id/t7" android:gravity="center"
            android:layout_weight="1" android:textSize="26sp" android:textColor="#12111A" android:textStyle="bold"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent"
            android:text="8" android:id="@+id/t8" android:gravity="center"
            android:layout_weight="1" android:textSize="26sp" android:textColor="#12111A" android:textStyle="bold"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent"
            android:text="9" android:id="@+id/t9" android:gravity="center"
            android:layout_weight="1" android:textSize="26sp" android:textColor="#12111A" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
        android:layout_height="match_parent" android:layout_weight="1">

        <TextView android:id="@+id/tclear" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:enabled="false" android:gravity="center" android:text="⌫"
            android:textSize="26sp" android:textColor="#D4A843" android:textStyle="bold"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent"
            android:text="0" android:id="@+id/t0" android:gravity="center"
            android:layout_weight="1" android:textSize="26sp" android:textColor="#12111A" android:textStyle="bold"/>
        <TextView android:id="@+id/tdone" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:text="Enter"
            android:textSize="16sp" android:textColor="#D4A843" android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
