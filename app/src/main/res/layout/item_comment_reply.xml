<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:paddingTop="8dp">

    <!-- Avatar (smaller) -->
    <TextView
        android:id="@+id/tv_reply_avatar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="2dp"/>

    <!-- Content -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <!-- Handle + text -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_reply_handle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/tv_reply_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#CCCCCC"/>

        </LinearLayout>

        <!-- Time + like count -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/tv_reply_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#6B6B7A"
                android:layout_marginEnd="14dp"/>

            <TextView
                android:id="@+id/tv_reply_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#6B6B7A"
                android:layout_marginEnd="4dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Like button -->
    <TextView
        android:id="@+id/tv_reply_like"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:text="♡"
        android:textSize="14sp"
        android:textColor="#8A8A9A"
        android:gravity="center"
        android:layout_marginTop="2dp"/>

</LinearLayout>
