<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/social_surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="6dp">

        <FrameLayout
            android:id="@+id/fl_avatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/social_story_ring"
            android:padding="3dp">

            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/social_avatar_mask"
                android:clipToOutline="true"
                android:contentDescription="Profile image"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/social_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_verified"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/social_verified_badge"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/social_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_more"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Post options"
            android:padding="11dp"
            android:src="@drawable/ic_social_more" />
    </LinearLayout>

    <com.monarch.software.phase2.AspectRatioFrameLayout
        android:id="@+id/fl_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EFEFEF">

        <ImageView
            android:id="@+id/iv_post_media"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Post image"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/iv_heart_overlay"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:contentDescription="@null"
            android:elevation="8dp"
            android:padding="12dp"
            android:src="@drawable/ic_social_heart_filled"
            app:tint="#FFFFFF"
            android:visibility="gone" />
    </com.monarch.software.phase2.AspectRatioFrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageButton
            android:id="@+id/btn_like"
            style="@style/SocialActionButton"
            android:contentDescription="Like"
            android:src="@drawable/ic_social_heart_outline" />

        <ImageButton
            android:id="@+id/btn_comment"
            style="@style/SocialActionButton"
            android:contentDescription="Comment"
            android:src="@drawable/ic_social_comment" />

        <ImageButton
            android:id="@+id/btn_share"
            style="@style/SocialActionButton"
            android:contentDescription="Share"
            android:src="@drawable/ic_social_send" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_bookmark"
            style="@style/SocialActionButton"
            android:contentDescription="Save"
            android:src="@drawable/ic_social_bookmark_outline" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_like_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:textColor="@color/social_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:textColor="@color/social_text"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_view_comments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:textColor="@color/social_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_comment_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:textColor="@color/social_text"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_timestamp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp"
        android:textColor="@color/social_text_secondary"
        android:textSize="10sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/social_border" />

</LinearLayout>
